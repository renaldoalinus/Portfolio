---
// Studio layout — dedicated head for the rebuilt homepage template.
// Loads the studio design system (studio.css) instead of the old global styles
// so the two systems never conflict.
import '../styles/studio.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Portfolio of Renaldo — product designer.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!--
      Font stand-ins: the reference design uses Geomanist + Archia (commercial, Atipo Foundry).
      Onest ≈ Geomanist (geometric sans), Archivo ≈ Archia (neutral grotesque labels).
      If you license the originals, self-host them and swap --font-sans / --font-label in studio.css.
    -->
    <link
      href="https://fonts.googleapis.com/css2?family=Onest:wght@300..700&family=Archivo:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <slot />
  </body>
</html>
