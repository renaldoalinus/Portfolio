---
// BASE LAYOUT — the shared shell every page sits inside.
// Nav + footer + fonts + global styles live here ONCE, so every
// page inherits them. This is your "master component".
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /* Set on pages that already end in a contact ask, to suppress the
     footer's duplicate call-to-action. */
  bareFooter?: boolean;
}
const {
  title = 'Renaldo — Product Designer',
  description = 'Product designer crafting clear, human, high-impact digital products.',
  bareFooter = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />

    <!-- Social share preview -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Fonts: Fraunces (display serif) + Inter (body). Preconnect
         first so they load fast; swap to self-hosted later. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300..600&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer bare={bareFooter} />

    <!-- Global motion: entrance reveals on scroll. Small, no libraries. -->
    <script>
      const supportsMotion = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (supportsMotion && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
      } else {
        document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 200;
    padding: 0.75rem 1rem;
    background: var(--ink);
    color: var(--paper);
    border-radius: 0 0 8px 0;
  }
  .skip-link:focus { left: 0; }
</style>
