---
// Sneak peek: a full-bleed diagonal wall of real shots drifting in alternating
// directions behind a centered "Get in touch" pill, with a way through to the
// full gallery at /shots.
import { Image } from 'astro:assets';

const email = 'renaldo.alin@gmail.com';

// The wall draws on two sets: the /shots gallery, and case-study frames
// pre-cropped to the tile's 16:10 in src/assets/peek — cropping them at build
// time rather than leaving it to object-fit means each one is framed on
// purpose. Both fintech charts are deliberately absent: they are tall stacked
// boards, and a 16:10 crop of one shows a meaningless slice.
const shots = import.meta.glob<{ default: ImageMetadata }>('../../assets/shots/*.png', {
  eager: true,
});
const frames = import.meta.glob<{ default: ImageMetadata }>('../../assets/peek/*.png', {
  eager: true,
});
const byName = Object.fromEntries(
  Object.entries({ ...shots, ...frames }).map(([path, mod]) => [
    path.split('/').pop().replace('.png', ''),
    mod.default,
  ])
);

// Ordered so neighbours differ in colour and subject rather than clustering
// all the mint Vivy screens or all the pale Issuu ones together.
const wallShots = [
  'issuu-silkscreen-system',
  'vivy-nutrition-dashboard',
  'plusdental-aligners',
  'issuu-illustrated-icons',
  'issuu-flipbook-hero',
  'vivy-404-page',
  'fitness-app-screens',
  'vivy-kyc-id-motion-poster',
  'issuu-onboarding-laptop',
  'vivy-nutrition-mobile',
  'issuu-publication-preview',
  'vivy-signup-prompts',
  'issuu-plan-tiers',
  'vivy-projects-dashboard',
  'issuu-explanation-dialogs',
  'vivy-nutrition-overview',
  'vivy-activity-feed-poster',
].map((name) => byName[name]);

// 5 rows of 5, dealt from the list like a deck: each row picks up where the
// previous one left off, so no tile repeats until the whole set is spent.
const rows = Array.from({ length: 5 }, (_, i) =>
  Array.from({ length: 5 }, (_, j) => wallShots[(i * 5 + j) % wallShots.length])
);
const sets = [0, 1]; // duplicated for the seamless -50% loop
---

<section id="sneak-peek" class="peek">
  <div class="peek__wall" aria-hidden="true">
    <div class="peek__tilt">
      {rows.map((row, i) => (
        <div class="peek__row">
          <div class={`peek__track ${i % 2 === 0 ? 'animate-scroll-left' : 'animate-scroll-right'}`}>
            {sets.map(() => row.map((shot) => (
              <div class="peek__tile">
                <Image src={shot} alt="" width={420} loading="lazy" decoding="async" />
              </div>
            )))}
          </div>
        </div>
      ))}
    </div>
    <div class="peek__fade peek__fade--top"></div>
    <div class="peek__fade peek__fade--bottom"></div>
  </div>

  <div class="peek__actions">
    <a class="peek__cta" href={`mailto:${email}`}>
      Get in touch
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
    <a class="peek__gallery font-label" href="/shots/">
      Or browse all 11 shots
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</section>

<style>
  .peek {
    position: relative;
    width: 100%;
    overflow: hidden;
    min-height: 160vh;
    background: #000;
  }

  .peek__wall {
    position: absolute;
    inset: 0;
  }
  .peek__tilt {
    position: absolute;
    inset: -45%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 28px;
    transform: rotate(-32deg);
  }

  .peek__row {
    position: relative;
    width: 100%;
    overflow: visible;
    pointer-events: none;
    user-select: none;
  }
  .peek__track {
    display: flex;
    gap: 28px;
    width: max-content;
    padding-right: 28px;
  }
  .peek__tile {
    width: min(70vw, 360px);
    aspect-ratio: 16 / 10;
    border-radius: 18px;
    overflow: hidden;
    opacity: 0.92;
    flex-shrink: 0;
    background: #131313;
  }
  .peek__tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .peek__fade {
    position: absolute;
    inset-inline: 0;
    height: 18vh;
    pointer-events: none;
  }
  .peek__fade--top {
    top: 0;
    background: linear-gradient(180deg, var(--color-dark) 0%, transparent 100%);
  }
  .peek__fade--bottom {
    bottom: 0;
    background: linear-gradient(0deg, #000 0%, transparent 100%);
  }

  .peek__actions {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
  }

  .peek__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(10px);
    color: #000;
    font-weight: 500;
    font-size: 18px;
    border-radius: 999px;
    padding: 22px 42px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
    transition: transform 300ms var(--ease-out-expo), background-color 300ms var(--ease-out-expo);
  }
  .peek__cta:hover {
    transform: scale(1.04);
    background: #fff;
  }

  .peek__gallery {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    padding: 12px 22px;
    transition: color 260ms var(--ease-out-expo), border-color 260ms var(--ease-out-expo);
  }
  .peek__gallery:hover {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.5);
  }

  @media (prefers-reduced-motion: reduce) {
    .peek__cta:hover { transform: none; }
  }
</style>
