---
// Black footer: three contact columns + copy-email button, centered small print.
const email = 'renaldo.alin@gmail.com';
// TODO: replace with your real profile URLs.
const socials = [
  {
    label: 'LinkedIn',
    href: '#',
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5ZM.2 8h4.6v14.5H.2V8Zm7.4 0h4.4v2h.06c.61-1.16 2.11-2.38 4.34-2.38 4.64 0 5.5 3.06 5.5 7.04v7.84h-4.6v-6.95c0-1.66-.03-3.8-2.31-3.8-2.32 0-2.67 1.8-2.67 3.67v7.08H7.6V8Z"/></svg>',
  },
  {
    label: 'X / Twitter',
    href: '#',
    icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.4l-5.8-7.58-6.64 7.58H.47l8.6-9.83L0 1.15h7.6l5.24 6.93 6.06-6.93Zm-1.3 19.5h2.04L6.5 3.24H4.3l13.3 17.4Z"/></svg>',
  },
];
const year = new Date().getFullYear();
---

<footer id="footer" class="footer">
  <div class="footer__inner">
    <div class="footer__grid">
      {socials.map((social) => (
        <a class="footer__item" href={social.href} target="_blank" rel="noopener noreferrer">
          <span class="footer__icon" aria-hidden="true" set:html={social.icon} />
          <span class="footer__label">{social.label}</span>
          <span class="footer__arrow" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="13 6 19 12 13 18" />
            </svg>
          </span>
        </a>
      ))}

      <a class="footer__item" href={`mailto:${email}`}>
        <span class="footer__icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2.5" y="4.5" width="19" height="15" rx="2" />
            <path d="m3 6 9 7 9-7" />
          </svg>
        </span>
        <span class="footer__label">{email}</span>
        <button
          class="footer__copy"
          type="button"
          data-copy-email={email}
          aria-label="Copy email address"
        >
          <svg class="footer__copy-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" />
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
          </svg>
          <svg class="footer__check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 6 9 17l-5-5" />
          </svg>
        </button>
      </a>
    </div>

    <p class="footer__smallprint font-label">
      Designed by Renaldo
      <span class="footer__sep">·</span>
      Made with Claude
      <span class="footer__sep">·</span>
      {year}
    </p>
  </div>
</footer>

<style>
  .footer {
    background: #000;
    color: #fff;
    padding: 48px 16px 40px;
  }
  @media (min-width: 768px) {
    .footer { padding-inline: 24px; }
  }

  .footer__inner {
    max-width: 1400px;
    margin-inline: auto;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4px;
  }
  @media (min-width: 768px) {
    .footer__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 32px;
    }
  }

  .footer__item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 4px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    transition: border-color 300ms var(--ease-out-expo);
  }
  .footer__item:hover { border-color: rgba(255, 255, 255, 0.6); }

  .footer__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  .footer__label {
    font-weight: 450;
    font-size: 15px;
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .footer__arrow {
    display: inline-flex;
    opacity: 0.6;
    transition: transform 300ms var(--ease-out-expo), opacity 300ms var(--ease-out-expo);
  }
  .footer__item:hover .footer__arrow {
    opacity: 1;
    transform: translateX(4px);
  }

  .footer__copy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.65);
    transition: color 300ms var(--ease-out-expo), background-color 300ms var(--ease-out-expo);
  }
  .footer__copy:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
  }
  .footer__check-icon { display: none; }
  .footer__copy.is-copied .footer__copy-icon { display: none; }
  .footer__copy.is-copied .footer__check-icon { display: block; }

  .footer__smallprint {
    text-align: center;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.55);
    margin-top: 40px;
  }
  .footer__sep {
    color: rgba(255, 255, 255, 0.25);
    margin-inline: 4px;
  }
</style>
