---
// Black footer: three contact columns + copy-email button, centered small print.
const email = 'renaldo.alin@gmail.com';
// TODO: replace with your real profile URLs.
const socials = [
  { label: 'LinkedIn', href: '#' },
  { label: 'X / Twitter', href: '#' },
];
const year = new Date().getFullYear();
---

<footer id="footer" class="footer">
  <div class="footer__inner">
    <div class="footer__grid">
      <a class="footer__item" href={`mailto:${email}`}>
        <span class="footer__icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2.5" y="4.5" width="19" height="15" rx="2" />
            <path d="m3 6 9 7 9-7" />
          </svg>
        </span>
        <span class="footer__label">{email}</span>
        <button
          class="footer__copy"
          type="button"
          data-copy-email={email}
          aria-label="Copy email address"
        >
          <svg class="footer__copy-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" />
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
          </svg>
          <svg class="footer__check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 6 9 17l-5-5" />
          </svg>
        </button>
      </a>

      {socials.map((social) => (
        <a class="footer__item" href={social.href} target="_blank" rel="noopener noreferrer">
          <span class="footer__label">{social.label}</span>
          <span class="footer__arrow" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="13 6 19 12 13 18" />
            </svg>
          </span>
        </a>
      ))}
    </div>

    <p class="footer__smallprint font-label">
      Designed by Renaldo
      <span class="footer__sep">·</span>
      Made with Claude
      <span class="footer__sep">·</span>
      {year}
    </p>
  </div>
</footer>

<style>
  .footer {
    background: #000;
    color: #fff;
    padding: 48px 16px 40px;
  }
  @media (min-width: 768px) {
    .footer { padding-inline: 24px; }
  }

  .footer__inner {
    max-width: 1400px;
    margin-inline: auto;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  @media (min-width: 768px) {
    .footer__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 32px;
    }
  }

  .footer__item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 20px 24px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 20px;
    transition: background-color 300ms var(--ease-out-expo), border-color 300ms var(--ease-out-expo);
  }
  .footer__item:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .footer__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  .footer__label {
    font-weight: 450;
    font-size: 15px;
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .footer__arrow {
    display: inline-flex;
    opacity: 0.6;
    transition: transform 300ms var(--ease-out-expo), opacity 300ms var(--ease-out-expo);
  }
  .footer__item:hover .footer__arrow {
    opacity: 1;
    transform: translateX(4px);
  }

  .footer__copy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.65);
    transition: color 300ms var(--ease-out-expo), background-color 300ms var(--ease-out-expo);
  }
  .footer__copy:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
  }
  .footer__check-icon { display: none; }
  .footer__copy.is-copied .footer__copy-icon { display: none; }
  .footer__copy.is-copied .footer__check-icon { display: block; }

  .footer__smallprint {
    text-align: center;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.55);
    margin-top: 40px;
  }
  .footer__sep {
    color: rgba(255, 255, 255, 0.25);
    margin-inline: 4px;
  }
</style>
