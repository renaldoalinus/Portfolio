---
// Work section: sticky full-screen headline with scroll-driven word-by-word
// blur reveal, then project cards that rise over it.
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

// Sticky headline — your own line, split into words for the blur reveal.
const headlineLines = [
  ['I', 'map', 'messy', 'systems,'],
  ['design', 'the', 'flows', 'that', 'untangle', 'them,'],
  ['and', 'ship', 'the', 'details', 'that', 'matter.'],
];

// Set to a card index to render it as "coming soon" (pill + pulse dot, not
// clickable). Every project is real, so it is off.
const comingSoonIndex = -1;
---

<section id="work" class="work">
  <div class="work__sticky" data-blur-headline>
    <div class="work__sticky-inner">
      <div class="work__headline" aria-label="I map messy systems, design the flows that untangle them, and ship the details that matter.">
        {headlineLines.map((line) => (
          <div class="work__line">
            {line.map((word) => (
              <span class="work__word-outer" aria-hidden="true">
                <span class="work__word" data-blur-word>{word}</span>
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>

  <div id="work-cards" class="work__cards">
    <div class="work__grid">
      {projects.map((project, i) => {
        const Tag = i === comingSoonIndex ? 'div' : 'a';
        const href = i === comingSoonIndex ? undefined : `/work/${project.slug}/`;
        return (
        <div class="work__cell">
          <Tag class:list={['card', i === comingSoonIndex && 'card--soon']} href={href} data-card-reveal>
            {i === comingSoonIndex && (
              <span class="card__soon-pill font-label" aria-hidden="true">
                <span class="card__soon-dot animate-pulse"></span>
                Coming soon
              </span>
            )}

            <div class="card__frame">
              {project.data.thumb ? (
                <img
                  class="card__img"
                  src={project.data.thumb}
                  alt={project.data.title}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="card__img ph-box"><span class="ph-tag">Cover — 4:3</span></div>
              )}
            </div>

            <div class="card__foot">
              <div class="card__text">
                <span class="card__name">{project.data.title}</span>
                <span class="card__meta font-label">// {project.data.role}</span>
              </div>
              <span class="card__arrow" aria-hidden="true">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="4" y1="12" x2="19" y2="12" />
                  <polyline points="13 6 19 12 13 18" />
                </svg>
              </span>
            </div>
          </Tag>
        </div>
        );
      })}
      ))}
    </div>
  </div>
</section>

<style>
  .work {
    position: relative;
    max-width: 1720px;
    margin-inline: auto;
    padding-inline: 16px;
    padding-bottom: 96px;
    scroll-margin-top: 96px;
  }
  @media (min-width: 768px) {
    .work { padding-inline: 24px; padding-bottom: 128px; }
  }
  @media (min-width: 1024px) {
    .work { padding-bottom: 160px; }
  }

  .work__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100dvh;
    z-index: 0;
    pointer-events: none;
  }
  .work__sticky-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: 24px;
  }
  .work__headline {
    font-weight: 700;
    color: #000;
    text-align: center;
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-size: clamp(1.75rem, 7vw, 2.75rem);
    max-width: 1500px;
  }
  @media (min-width: 768px) {
    .work__headline {
      line-height: 1.02;
      font-size: clamp(2rem, 5.6vw, 5.25rem);
    }
  }
  .work__line { display: block; }
  .work__word-outer { display: inline; }
  .work__word-outer::after { content: ' '; }
  .work__word {
    display: inline-block;
    filter: blur(18px);
    opacity: 0.12;
    will-change: filter, opacity;
  }

  .work__cards {
    position: relative;
    z-index: 10;
    scroll-margin-top: 96px;
  }
  .work__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 64px 0;
    margin-top: 48px;
    align-items: start;
  }
  @media (min-width: 768px) {
    .work__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 80px 32px;
      margin-top: 64px;
    }
  }
  @media (min-width: 1024px) {
    .work__grid { gap: 96px 56px; }
  }
  .work__cell {
    position: relative;
    z-index: 10;
  }
  @media (min-width: 768px) {
    .work__cell { grid-column: span 6; padding-inline: 15px; }
  }

  [data-card-reveal] {
    opacity: 0;
    transform: translate3d(0, 120px, 0);
    transition:
      opacity 900ms var(--ease-out-expo),
      transform 900ms var(--ease-out-expo),
      box-shadow 300ms var(--ease-out-expo);
    will-change: transform, opacity;
  }
  [data-card-reveal].is-in {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .card {
    position: relative;
    display: block;
    border-radius: 28px;
    background: #fff;
    /* the image sits inset inside the card rather than running to its edge */
    padding: 12px 12px 0;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06), 0 12px 32px -18px rgba(0, 0, 0, 0.25);
    transition: transform 400ms var(--ease-out-expo), box-shadow 400ms var(--ease-out-expo);
  }
  @media (min-width: 768px) {
    .card { padding: 14px 14px 0; }
  }
  .card:hover {
    transform: translateY(-4px) !important;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06), 0 28px 60px -20px rgba(0, 0, 0, 0.32);
  }
  .card--soon { cursor: default; }

  .card__soon-pill {
    position: absolute;
    top: 26px;
    right: 26px;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border-radius: 999px;
    padding: 6px 12px;
    background: #000;
    color: #fff;
  }
  .card__soon-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #fff;
  }

  .card__frame {
    position: relative;
    overflow: hidden;
    border-radius: 18px;
    /* every tile is 4:3, so the frame matches and nothing is cropped */
    aspect-ratio: 4 / 3;
    background: #eef1f7;
  }
  .card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-out-expo);
  }
  .card:hover .card__img { transform: scale(1.03); }

  .card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 18px 14px 20px;
  }
  @media (min-width: 768px) {
    .card__foot { padding: 20px 18px 22px; }
  }
  .card__text {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }
  .card__name {
    font-weight: 500;
    font-size: 19px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: #000;
  }
  @media (min-width: 768px) {
    .card__name { font-size: 21px; }
  }
  .card__meta {
    font-size: 13.5px;
    font-weight: 400;
    line-height: 1.35;
    color: rgba(0, 0, 0, 0.45);
  }
  .card__arrow {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: rgba(0, 0, 0, 0.75);
    transition: transform 400ms var(--ease-out-expo), color 400ms var(--ease-out-expo);
  }
  .card:hover .card__arrow {
    transform: translateX(4px);
    color: #000;
  }
</style>
