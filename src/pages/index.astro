---
// Homepage — template rebuilt from the studied DNA of blingbling.studio
// (structure + interaction patterns only; all content, code and imagery are ours).
// The hero is fixed; everything after the spacer scrolls over it.
import Studio from '../layouts/Studio.astro';
import Nav from '../components/studio/Nav.astro';
import Hero from '../components/studio/Hero.astro';
import Work from '../components/studio/Work.astro';
import About from '../components/studio/About.astro';
import Hacks from '../components/studio/Hacks.astro';
import Peek from '../components/studio/Peek.astro';
import Footer from '../components/studio/Footer.astro';
---

<Studio
  title="Renaldo — Product Designer Portfolio"
  description="Portfolio of Renaldo — product designer crafting fintech and clean-energy products."
>
  <Nav />
  <Hero />

  <main class="page-main">
    <!-- spacer: the fixed hero owns the first viewport -->
    <div class="hero-spacer" aria-hidden="true"></div>

    <Work />

    <!-- scroll-driven circular reveal into the dark half of the page -->
    <div class="circle-zone" data-circle-zone aria-hidden="true">
      <div class="circle-zone__sticky">
        <div class="circle-zone__disc" data-circle-disc></div>
      </div>
    </div>

    <div class="dark-wrap">
      <About />
      <Hacks />
      <Peek />
    </div>
  </main>

  <Footer />

  <script>
    import '../scripts/studio.js';
  </script>
</Studio>

<style>
  .page-main {
    position: relative;
    z-index: 10;
  }
  .hero-spacer {
    height: 100vh;
    height: 100dvh;
  }
  .dark-wrap {
    background: var(--color-dark);
  }
  .circle-zone {
    position: relative;
    height: 160vh;
    z-index: 5;
    pointer-events: none;
  }
  .circle-zone__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: clip;
  }
  .circle-zone__disc {
    position: absolute;
    left: 50%;
    top: 115%;
    width: 100vmax;
    height: 100vmax;
    border-radius: 50%;
    background: var(--color-dark);
    transform: translate(-50%, -50%) scale(0.1);
    will-change: transform;
  }
  @media (prefers-reduced-motion: reduce) {
    .circle-zone { display: none; }
  }
</style>
