---
// Case-study page, restyled into the studio design system.
import { getCollection, type CollectionEntry } from 'astro:content';
import Studio from '../../layouts/Studio.astro';
import Nav from '../../components/studio/Nav.astro';
import Footer from '../../components/studio/Footer.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await project.render();
const { title, company, role, timeframe, summary, metric, tags } = project.data;
---

<Studio title={`${title} — Renaldo`} description={summary}>
  <Nav />

  <main class="case">
    <article class="case__inner">
      <a href="/#work-cards" class="case__back">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M13 8H3M7 4L3 8l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Back to work
      </a>

      <header class="case__head">
        <div class="case__chips">
          {tags.map((tag: string) => <span class="chip chip--dark">{tag}</span>)}
        </div>
        <h1 class="case__title">{title}</h1>
        <p class="case__summary">{summary}</p>
        <dl class="case__meta font-label">
          <div><dt>Company</dt><dd>{company}</dd></div>
          <div><dt>Role</dt><dd>{role}</dd></div>
          <div><dt>Timeframe</dt><dd>{timeframe}</dd></div>
          {metric && <div><dt>{metric.label}</dt><dd>{metric.value}</dd></div>}
        </dl>
      </header>

      <div class="case__cover ph-box">
        <span class="ph-tag">Case cover — 21:9</span>
      </div>

      <div class="case__prose">
        <Content />
      </div>
    </article>
  </main>

  <Footer />
</Studio>

<style>
  .case {
    padding: 140px 16px 96px;
  }
  @media (min-width: 768px) {
    .case { padding-inline: 24px; }
  }
  .case__inner {
    max-width: 900px;
    margin-inline: auto;
  }

  .case__back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 450;
    font-size: 15px;
    color: rgba(0, 0, 0, 0.6);
    transition: color 300ms var(--ease-out-expo);
  }
  .case__back:hover { color: #000; }

  .case__head { margin-top: 32px; }
  .case__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }
  .case__title {
    font-weight: 500;
    font-size: clamp(2.2rem, 5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #000;
  }
  .case__summary {
    font-weight: 450;
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    line-height: 1.5;
    color: rgba(0, 0, 0, 0.55);
    max-width: 640px;
    margin-top: 16px;
  }

  .case__meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 32px;
    margin: 36px 0 0;
    padding-top: 28px;
    border-top: 1px solid rgba(0, 0, 0, 0.15);
  }
  @media (min-width: 640px) {
    .case__meta { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .case__meta dt {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.45);
    margin-bottom: 6px;
  }
  .case__meta dd {
    margin: 0;
    font-size: 15px;
    font-weight: 500;
    color: #000;
  }

  .case__cover {
    aspect-ratio: 21 / 9;
    border-radius: 28px;
    overflow: hidden;
    margin-top: 48px;
  }

  .case__prose {
    margin-top: 56px;
    font-size: 17px;
    line-height: 1.7;
    color: rgba(0, 0, 0, 0.75);
    max-width: 720px;
  }
  .case__prose :global(h2) {
    font-weight: 600;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    letter-spacing: -0.01em;
    color: #000;
    margin: 48px 0 16px;
    line-height: 1.15;
  }
  .case__prose :global(p) { margin: 0 0 16px; }
  .case__prose :global(ul),
  .case__prose :global(ol) {
    padding-left: 22px;
    margin: 0 0 16px;
    list-style: disc;
  }
  .case__prose :global(li) { margin-bottom: 8px; }
  .case__prose :global(blockquote) {
    margin: 28px 0;
    padding: 20px 28px;
    border-left: 3px solid #000;
    background: rgba(242, 246, 255, 0.7);
    border-radius: 0 20px 20px 0;
    font-weight: 500;
    color: #000;
  }
  .case__prose :global(blockquote p) { margin: 0; }
  .case__prose :global(em) { color: rgba(0, 0, 0, 0.5); }
  .case__prose :global(img) {
    border-radius: 20px;
    margin: 24px 0;
  }
</style>
