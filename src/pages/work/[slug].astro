---
// Case-study page — dark layout with sticky numbered side navigation.
// The side nav is generated from the markdown's ## headings, so each
// project gets its own menu items.
import { getCollection, type CollectionEntry } from 'astro:content';
import Studio from '../../layouts/Studio.astro';
import { projectThemes, fallbackTheme } from '../../styles/project-themes';
import Nav from '../../components/studio/Nav.astro';
import Footer from '../../components/studio/Footer.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content, headings } = await project.render();
const { title, company, role, timeframe, summary, tags, cover, metrics, metricsNote } =
  project.data;

// Each project paints itself from its own theme. Every colour in it is
// contrast-fitted against that theme's background — see project-themes.ts.
const theme = projectThemes[project.slug] ?? fallbackTheme;
const themeVars = [
  `--case-bg:${theme.bg}`,
  `--case-fg-strong:${theme.fgStrong}`,
  `--case-fg:${theme.fg}`,
  `--case-muted:${theme.muted}`,
  `--case-rule:${theme.rule}`,
  `--accent:${theme.accent}`,
].join(';');
const navItems = headings.filter((h) => h.depth === 2);

// Some case studies are presented purely as images — the whole write-up is
// baked into the exported artboards, so the markdown carries almost no prose.
// Those pages have nothing to navigate and no lines to keep readable, so they
// drop the side nav and give the images the full column width instead.
const proseWords = project.body
  .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ') // image syntax
  .replace(/^#{1,6} .*$/gm, ' ')           // headings
  .replace(/[*_`>[\]()#-]/g, ' ')          // markdown punctuation
  .split(/\s+/)
  .filter(Boolean).length;
const imageLed = proseWords < 60;

// next project by homepage order, wrapping around
const all = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const idx = all.findIndex((p) => p.slug === project.slug);
const next = all[(idx + 1) % all.length];
---

<Studio title={`${title} — Renaldo`} description={summary}>
  <Nav />

  <main class:list={['case', `case--${theme.mode}`]} style={themeVars}>
    <header class="case__head">
      <div class="case__head-grid">
        <div>
          <span class="case__eyebrow font-label">{company} · {timeframe}</span>
          <h1 class="case__title">{title}</h1>
          <p class="case__subtitle">{summary}</p>
        </div>
        <aside class="case__meta font-label">
          <div>
            <span class="case__meta-label">Company</span>
            <span class="case__meta-value">{company}</span>
          </div>
          <div>
            <span class="case__meta-label">Role</span>
            <span class="case__meta-value">{role}</span>
          </div>
          <div>
            <span class="case__meta-label">Timeline</span>
            <span class="case__meta-value">{timeframe}</span>
          </div>
          <div>
            <span class="case__meta-label">Focus</span>
            <span class="case__meta-value">{tags.join(' · ')}</span>
          </div>
        </aside>
      </div>
    </header>

    {metrics.length > 0 && (
      <section class="case__impact" aria-label="Impact">
        <div class="case__impact-head font-label">
          <span>Impact</span>
          {metricsNote && <span class="case__impact-note">{metricsNote}</span>}
        </div>
        <dl class="case__stats" style={`--cols:${metrics.length}`}>
          {metrics.map((m) => (
            <div class="case__stat">
              <dt class="case__stat-value">{m.value}</dt>
              <dd class="case__stat-label font-label">{m.label}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    {cover && (
      <figure class="case__cover">
        <img src={cover} alt="" loading="eager" decoding="async" />
      </figure>
    )}

    <div class="case__body">
      <div class:list={['case__grid', imageLed && 'case__grid--wide']}>
        {imageLed && (
          <a href="/#work-cards" class="case__back case__back--solo font-label">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="19" y1="12" x2="5" y2="12" />
              <polyline points="12 19 5 12 12 5" />
            </svg>
            Back
          </a>
        )}
        {!imageLed && (
        <aside class="case__sidenav">
          <nav class="case__sidenav-inner" data-case-nav>
            <a href="/#work-cards" class="case__back font-label">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="19" y1="12" x2="5" y2="12" />
                <polyline points="12 19 5 12 12 5" />
              </svg>
              Back
            </a>
            <span class="case__sidenav-label font-label">On this page</span>
            {navItems.map((h, i) => (
              <a href={`#${h.slug}`} class="case__sidenav-item" data-target={h.slug}>
                <span class="case__sidenav-num font-label">{String(i + 1).padStart(2, '0')}</span>
                <span class="case__sidenav-text">{h.text}</span>
              </a>
            ))}
          </nav>
        </aside>
        )}

        <article class="case__content">
          <Content />

          <div class="case__next">
            <span class="case__sidenav-label font-label">Next project</span>
            <a href={`/work/${next.slug}/`} class="case__next-link">
              <p class="case__next-title">{next.data.title}</p>
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </a>
          </div>
        </article>
      </div>
    </div>
  </main>

  <Footer />

  <script>
    import Lenis from 'lenis';

    // Dark page: the top nav needs its white pill state from the start.
    document.getElementById('site-nav')?.classList.add('is-scrolled');

    // Same smooth scrolling the homepage uses, so clicking a section in the
    // rail glides there instead of jumping.
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let lenis = null;
    if (!reduced) {
      lenis = new Lenis({ autoRaf: false });
      const raf = (time) => {
        lenis.raf(time);
        requestAnimationFrame(raf);
      };
      requestAnimationFrame(raf);
    }

    // Scrollspy: highlight the side-nav item of the section in view.
    const links = Array.from(document.querySelectorAll('[data-case-nav] .case__sidenav-item'));

    // Clicking a rail item glides to its section (matching the headings'
    // scroll-margin so the sticky nav never covers the title).
    links.forEach((link) => {
      link.addEventListener('click', (e) => {
        const target = document.getElementById(link.getAttribute('data-target'));
        if (!target) return;
        e.preventDefault();
        if (lenis) lenis.scrollTo(target, { offset: -128, duration: 1.1 });
        else target.scrollIntoView({ behavior: 'smooth' });
      });
    });

    const targets = links
      .map((l) => document.getElementById(l.getAttribute('data-target')))
      .filter(Boolean);
    if (targets.length) {
      const activate = (id) => {
        links.forEach((l) => l.classList.toggle('is-active', l.getAttribute('data-target') === id));
      };
      const spy = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) activate(e.target.id);
          });
        },
        { rootMargin: '-20% 0px -70% 0px' }
      );
      targets.forEach((t) => spy.observe(t));
      activate(targets[0].id);
    }
  </script>
</Studio>

<style>
  .case {
    background: var(--case-bg);
    color: var(--case-fg-strong);
    counter-reset: case-section;
  }

  .case__head {
    max-width: 1360px;
    margin-inline: auto;
    padding: 160px 24px 64px;
  }
  @media (min-width: 1024px) {
    .case__head { padding: 176px 48px 64px; }
  }

  .case__head-grid {
    display: grid;
    gap: 48px;
    align-items: end;
  }
  @media (min-width: 1024px) {
    .case__head-grid { grid-template-columns: 1fr 320px; gap: 80px; }
  }

  .case__eyebrow {
    display: inline-block;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 16px;
  }
  .case__title {
    font-weight: 450;
    font-size: clamp(2.6rem, 6vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
    color: var(--case-fg-strong);
    overflow-wrap: anywhere;
  }
  .case__subtitle {
    margin-top: 24px;
    font-weight: 500;
    font-size: clamp(1.15rem, 2vw, 1.6rem);
    line-height: 1.3;
    color: var(--case-fg);
    max-width: 640px;
  }

  .case__meta {
    display: flex;
    flex-direction: column;
    gap: 20px;
    border-left: 1px solid var(--case-rule);
    padding-left: 24px;
  }
  @media (min-width: 1024px) {
    .case__meta { padding-left: 32px; }
  }
  .case__meta-label {
    display: block;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--case-muted);
    margin-bottom: 4px;
  }
  .case__meta-value {
    display: block;
    font-size: 14px;
    color: var(--case-fg);
    line-height: 1.45;
  }

  .case__impact {
    max-width: 1440px;
    margin: 0 auto 56px;
    padding: 0 24px;
  }
  @media (min-width: 1024px) {
    .case__impact { padding-inline: 48px; }
  }
  .case__impact-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--case-muted);
    margin-bottom: 14px;
  }
  .case__impact-note {
    text-align: right;
    letter-spacing: 0.08em;
    text-transform: none;
    color: var(--case-muted);
  }
  .case__stats {
    display: grid;
    gap: 28px;
    margin: 0;
    padding: 32px;
    border: 1px solid var(--case-rule);
    border-radius: 18px;
  }
  @media (min-width: 768px) {
    .case__stats {
      grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
      gap: 40px;
      padding: 38px 44px;
    }
  }
  .case__stat-value {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--case-fg-strong);
    font-variant-numeric: tabular-nums;
  }
  .case__stat-label {
    margin: 10px 0 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--case-muted);
    max-width: 30ch;
  }

  .case__cover {
    max-width: 1440px;
    margin: 0 auto 72px;
    padding: 0 24px;
  }
  .case__cover img {
    width: 100%;
    height: auto;
    border-radius: 16px;
  }
  @media (min-width: 1024px) {
    .case__cover { padding-inline: 48px; }
  }

  .case__body {
    max-width: 1440px;
    margin-inline: auto;
    padding: 0 24px 80px;
  }
  @media (min-width: 1024px) {
    .case__body { padding-inline: 48px; }
  }
  .case__grid {
    display: block;
  }
  @media (min-width: 1024px) {
    .case__grid {
      display: grid;
      /* narrow rail, tight gutter: the content column gets the rest, so images
         run wide while prose stays capped at a readable measure */
      grid-template-columns: 180px 1fr;
      gap: 64px;
    }
    /* image-led decks: no side nav, so the images get the whole grid width */
    .case__grid--wide {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
  }

  /* stands in for the back link that normally lives at the top of the side nav */
  .case__back--solo {
    margin-bottom: 40px;
  }

  .case__sidenav { display: none; }
  @media (min-width: 1024px) {
    .case__sidenav { display: block; }
  }
  .case__sidenav-inner {
    position: sticky;
    top: 128px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .case__back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--case-muted);
    margin-bottom: 24px;
    transition: color 300ms var(--ease-out-expo);
  }
  .case__back:hover { color: var(--case-fg-strong); }
  .case__back svg { transition: transform 300ms var(--ease-out-expo); }
  .case__back:hover svg { transform: translateX(-2px); }

  .case__sidenav-label {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--case-muted);
    margin-bottom: 12px;
  }
  .case__sidenav-item {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 10px 12px;
    margin-inline: -12px;
    border-radius: 10px;
    color: var(--case-muted);
    transition: color 300ms var(--ease-out-expo), background-color 300ms var(--ease-out-expo);
  }
  .case__sidenav-item:hover { color: var(--case-fg-strong); }
  .case__sidenav-item.is-active {
    background: color-mix(in srgb, var(--case-fg-strong) 10%, transparent);
    color: var(--case-fg-strong);
  }
  .case__sidenav-num {
    font-size: 11px;
    letter-spacing: 0.12em;
    font-variant-numeric: tabular-nums;
    color: var(--case-muted);
  }
  .case__sidenav-item.is-active .case__sidenav-num { color: var(--case-muted); }
  .case__sidenav-text {
    font-weight: 500;
    font-size: 15px;
  }

  /* ---------- markdown content, styled to the section system ---------- */
  .case__content {
    min-width: 0;
    font-size: 16px;
    line-height: 1.7;
  }

  .case__content :global(h2) {
    counter-increment: case-section;
    display: flex;
    align-items: baseline;
    gap: 12px;
    border-top: 1px solid var(--case-rule);
    margin: 40px 0 40px;
    padding-top: 48px;
    scroll-margin-top: 128px;
    font-family: var(--font-label);
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--case-muted);
  }
  .case__content :global(h2::before) {
    content: counter(case-section, decimal-leading-zero);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--case-muted);
    font-variant-numeric: tabular-nums;
  }
  .case__content :global(h2:first-child) {
    border-top: 0;
    margin-top: 0;
    padding-top: 0;
  }

  .case__content :global(h3) {
    font-weight: 500;
    font-size: 22px;
    color: var(--case-fg-strong);
    margin: 48px 0 20px;
    line-height: 1.25;
  }
  .case__content :global(p) {
    font-family: var(--font-label);
    color: var(--case-fg);
    margin: 0 0 16px;
    max-width: 720px;
  }
  .case__content :global(em) {
    color: var(--case-muted);
    font-style: normal;
  }
  .case__content :global(strong) { color: var(--case-fg-strong); }
  .case__content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .case__content :global(ul),
  .case__content :global(ol) {
    font-family: var(--font-label);
    color: var(--case-fg);
    padding-left: 22px;
    margin: 0 0 16px;
    list-style: disc;
    max-width: 720px;
  }
  .case__content :global(li) { margin-bottom: 8px; }

  .case__content :global(p:has(img)) {
    max-width: none;
  }
  .case__content :global(img) {
    width: 100%;
    height: auto;
    border-radius: 16px;
    border: 1px solid var(--case-rule);
    margin: 40px 0;
    display: block;
  }

  /* ---------- next project ---------- */
  .case__next {
    border-top: 1px solid var(--case-rule);
    margin-top: 96px;
    padding-top: 24px;
  }
  .case__next-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 8px;
    color: var(--case-fg-strong);
  }
  .case__next-title {
    font-weight: 450;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.15;
  }
  .case__next-link svg {
    flex-shrink: 0;
    opacity: 0.6;
    transition: transform 300ms var(--ease-out-expo), opacity 300ms var(--ease-out-expo);
  }
  .case__next-link:hover svg {
    opacity: 1;
    transform: translateX(4px);
  }
</style>
